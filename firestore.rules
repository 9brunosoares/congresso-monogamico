rules_version = '2';
// Modelos: people/{id}: nick string<=30, photo string<=80, uid string<=128 ou null,
// admin bool (campos de identidade imutáveis, salvo primeiro vínculo de uid).
// admins/{uid}: id oficial string<=20; criado apenas no primeiro vínculo de ADM.
// settings/main: budget number 0..1000000.
// pixKeys/{id}: type enum e value string1..77; titular escreve, grupo lê.
// expenses: amountCents int1..100000000, by oficial (vazio apenas em baseline legado).
// Financeiro versionado: version int1..1000000, updatedAt timestamp, updatedBy oficial.
// expenses/payments: status active|cancelled, sem exclusão física. by/createdAt/at imutáveis.
// payments: from/to oficiais distintos, amountCents int1..100000000,
// kind payment|settlement, paidOn YYYY-MM-DD até hoje SP, note string<=200.
// financeHistory/{tipo_id_versao}: type expense|payment|budget, recordId<=80,
// version, action create|update|cancel, by, before/after cópias exatas, createdAt.
// Eventos imutáveis e obrigatórios na mesma transação. Baselines só via migração administrativa.
// financeControl/main: revision int,closed bool,lastEvent string<=120; revisão atômica.
// financeClosings/main: budget,expenseTotalCents,transfers com listas from/to/amountCents
// paralelas de até13 itens, version1,updatedAt/By,closedAt/By; imutável.
// agenda/{id}: d int18..22, t HH:mm, title<=120, place<=100, pts int0..100,
// prep<=500, note<=500, start/end epoch millis (sessão de até 24h).
// points/{id}: who oficial, d int -100..100, why<=200, kind aux|jogo|inf,
// at<=40, createdAt timestamp imutável. Apenas ADMs escrevem pontos.
// expenses/{id}: title<=120, cat enum, amount number 0..1000000, payer oficial,
// split lista de 1..14 IDs oficiais únicos, at<=40, createdAt timestamp imutável.
// cases/{id}: who/by oficiais, what<=500, status pend|ok, at<=40,
// createdAt imutável; somente ADM julga ou exclui.
// tasks/{id}: who oficial, d int1..20, why<=200, status pend|ok|no,
// at<=40, createdAt imutável; participante envia a própria tarefa; ADM aprova.
// chat/{id}: SOMENTE text string1..280 e createdAt timestamp. Sem autor/uid.
// caseReactions/{caseId}: votes mapa de até14 IDs oficiais para um dos cinco emojis.
// Só publicações condenadas; cada membro altera somente a própria entrada.
// querido/{diaSP}: {counts,voters}, com os 14 IDs no mapa counts.
// Cada valor é um número inteiro0..3722304989 com oito totais em base16.
// Cada dígito armazena o total de um emoji (ordem fixa no roster.js), máximo13.
// Não preserva a ordem dos votos nem ligação entre autor e escolha.
// Contadores e marcador são atualizados na mesma transação (dois documentos).
// querido/{diaSP}/voters/{uid}: SOMENTE voted:true. Somente o próprio lê.
// DiaSP é o número inteiro de dias desde epoch, descontando UTC-3.
service cloud.firestore {
 match /databases/{database}/documents {
  function ids() { return ['bruno', 'ob', 'luan', 'igor', 'pig', 'pelado', 'kirk', 'gherardi', 'nanu', 'sadano', 'ibrahim', 'cadu', 'diogo', 'felipe']; }
  function isAuthenticated() { return request.auth != null; }
  function isOwner(uid) { return isAuthenticated() && request.auth.uid == uid; }
  function personId() { return request.auth.token.email.split('@')[0]; }
  function isKnownAccount() { return isAuthenticated() && personId() in ids() && request.auth.token.email == personId() + '@congresso.app'; }
  function profilePath() { return /databases/$(database)/documents/people/$(personId()); }
  // UID só é vinculado pelo cadastro oficial; a posse desse UID define a participação.
  function isMember() { return isAuthenticated() && get(profilePath()).data.uid == request.auth.uid; }
  function isAdmin() { return isMember() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
  function uidUnchanged() { return request.resource.data.uid == request.auth.uid; }
  function uidNotModified(before,after) { return !after.keys().hasAny(['uid']) || before.uid == after.uid; }
  function text(v,max) { return v is string && v.size() > 0 && v.size() <= max; }
  function optionalText(v,max) { return v is string && v.size() <= max; }
  function only(d,fields) { return d.keys().hasAll(fields) && d.keys().hasOnly(fields); }
  function fresh(d) { return d.createdAt is timestamp && d.createdAt == request.time; }
  function sameCreation() { return request.resource.data.createdAt == resource.data.createdAt && uidNotModified(resource.data,request.resource.data); }
  function isValidPerson(d,id) {
   return only(d,['nick','photo','uid','admin']) && id in ids() && text(d.nick,30)
    && d.photo == 'img/' + id + '.jpg' && d.uid is string && d.uid.size() <= 128 && d.admin is bool;
  }
  match /people/{id} {
   allow get: if isMember() || (isKnownAccount() && personId() == id);
   allow list: if isMember();
   allow create, delete: if false;
   allow update: if isKnownAccount() && personId() == id && resource.data.uid == null
    && uidUnchanged() && isValidPerson(request.resource.data,id)
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid']);
  }
  match /admins/{uid} {
   allow get: if isOwner(uid) && isKnownAccount();
   allow list, update, delete: if false;
   allow create: if isOwner(uid) && isKnownAccount()
    && only(request.resource.data,['id']) && request.resource.data.id == personId()
    && get(profilePath()).data.uid == null && get(profilePath()).data.admin == true
    && getAfter(profilePath()).data.uid == uid;
  }
  function financeMeta(d) { return d.version is int && d.version > 0 && d.version <= 1000000 && d.updatedAt is timestamp && d.updatedAt == request.time && d.updatedBy == personId(); }
  function isValidSettings(d) { return only(d,['budget','version','updatedAt','updatedBy']) && d.budget is number && d.budget >= 0 && d.budget <= 1000000 && financeMeta(d); }
  function auditPath(type,id,version) { return /databases/$(database)/documents/financeHistory/$(type + '_' + id + '_' + string(version)); }
  function audited(type,id) {
   let d=request.resource.data;
   let e=getAfter(auditPath(type,id,d.version)).data;
   let before=request.method == 'create' ? {} : resource.data;
   let control=getAfter(/databases/$(database)/documents/financeControl/main).data;
   // O schema/autoria/data do evento são validados em financeHistory; a cópia
   // exata e o ID versionado impedem reutilizar um evento anterior.
   return e.after == d && e.before == before
    && control.revision == get(/databases/$(database)/documents/financeControl/main).data.revision + 1
    && control.lastEvent == type + '_' + id + '_' + string(d.version);
  }
  function accountsOpen() { return get(/databases/$(database)/documents/financeControl/main).data.closed == false; }
  function financeUpdate() {
   return (resource.data.status == 'active' || (resource.data.get('kind','') == 'settlement' && request.resource.data.status == 'active')) && request.resource.data.version == resource.data.version + 1
    && sameCreation() && request.resource.data.by == resource.data.by && request.resource.data.at == resource.data.at;
  }
  match /settings/{id} {
   allow read: if isMember();
   allow create: if false;
   allow update: if id == 'main' && isAdmin() && accountsOpen() && isValidSettings(request.resource.data)
    && request.resource.data.version == resource.data.version + 1 && audited('budget',id);
   allow delete: if false;
  }
  // Recursos compartilhados só com membros; edição ADM, independente do financeiro.
  function officialUrl(v) { return v is string && v.size() <= 2000 && (v == '' || v.matches('https://[a-zA-Z0-9][^ <>" ]*')); }
  function validOfficialLinks(d) {
   return only(d,['albumUrl','playlistUrl','mapUrl','airbnbUrl','address','wifiName','wifiPassword','version','updatedAt','updatedBy'])
    && officialUrl(d.albumUrl) && officialUrl(d.playlistUrl) && officialUrl(d.mapUrl) && officialUrl(d.airbnbUrl)
    && optionalText(d.address,300) && optionalText(d.wifiName,80) && optionalText(d.wifiPassword,120)
    && d.version is int && d.version > 0 && d.version <= 1000000 && d.updatedAt is timestamp
    && d.updatedAt == request.time && d.updatedBy == personId();
  }
  match /officialLinks/{id} {
   allow read: if isMember();
   allow create: if id == 'main' && isAdmin() && validOfficialLinks(request.resource.data) && request.resource.data.version == 1;
   allow update: if id == 'main' && isAdmin() && validOfficialLinks(request.resource.data) && request.resource.data.version == resource.data.version + 1;
   allow delete: if false;
  }
  function isValidPix(d) {
   return only(d,['type','value']) && text(d.value,77)
    && (d.type == 'aleatoria' && d.value.matches('[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}')
     || d.type == 'cpf' && d.value.matches('[0-9]{11}')
     || d.type == 'telefone' && d.value.matches('[+][1-9][0-9]{9,14}')
     || d.type == 'email' && d.value.matches('[^ @]+@[^ @]+[.][^ @]+'));
  }
  match /pixKeys/{id} {
   allow read: if isMember();
   allow create, update: if isMember() && id == personId() && isValidPix(request.resource.data);
   allow delete: if isMember() && id == personId();
  }
  function isValidAgenda(d) {
   return only(d,['d','t','title','place','pts','prep','note','start','end'])
    && d.d is int && d.d >= 18 && d.d <= 22 && d.t is string && d.t.matches('([01][0-9]|2[0-3]):[0-5][0-9]')
    && text(d.title,120) && optionalText(d.place,100) && optionalText(d.prep,500) && optionalText(d.note,500)
    && d.pts is int && d.pts >= 0 && d.pts <= 100
    && d.start is number && d.start > 0 && d.start < 4102444800000
    && d.end is number && d.end > d.start && d.end <= d.start + 86400000;
  }
  match /agenda/{id} {
   allow read: if isMember();
   allow create, update: if isAdmin() && isValidAgenda(request.resource.data);
   allow delete: if isAdmin();
  }
  function isValidPoint(d) {
   return only(d,['who','d','why','kind','at','createdAt']) && d.who in ids()
    && d.d is int && d.d != 0 && d.d >= -100 && d.d <= 100
    && text(d.why,200) && d.kind in ['aux','jogo','inf'] && text(d.at,40) && d.createdAt is timestamp;
  }
  function scoringOpen() { return !exists(/databases/$(database)/documents/scoreClosures/main); }
  match /scoreClosures/{id} {
   allow read: if isMember();
   allow create: if id == 'main' && isAdmin() && only(request.resource.data,['closedAt','closedBy'])
    && request.resource.data.closedAt is timestamp && request.resource.data.closedAt == request.time && request.resource.data.closedBy == personId();
   allow update, delete: if false;
  }
  match /points/{id} {
   allow read: if isMember();
   allow create: if isAdmin() && scoringOpen() && isValidPoint(request.resource.data) && fresh(request.resource.data);
   allow update: if isAdmin() && scoringOpen() && isValidPoint(request.resource.data) && sameCreation();
   allow delete: if isAdmin() && scoringOpen();
  }
  function isValidExpense(d) {
   return only(d,['title','cat','amount','amountCents','by','payer','split','at','createdAt','status','version','updatedAt','updatedBy']) && text(d.title,120)
    && d.cat in ['casa','mercado','bebida','transporte','atividades','colocacao','outros']
    && d.amount is number && d.amount > 0 && d.amount <= 1000000 && d.payer in ids()
    && d.amount == int(d.amount * 100 + 0.5) / 100.0
    && d.amountCents is int && d.amountCents > 0 && d.amountCents <= 100000000 && d.amount == d.amountCents / 100.0
    && (d.by in ids() || d.by == '') && d.status in ['active','cancelled'] && financeMeta(d)
    && d.split is list && d.split.size() > 0 && d.split.size() <= 14
    && d.split.toSet().size() == d.split.size() && d.split.hasOnly(ids()) && text(d.at,40) && d.createdAt is timestamp;
  }
  match /expenses/{id} {
   allow read: if isMember();
   allow create: if isMember() && accountsOpen() && isValidExpense(request.resource.data) && fresh(request.resource.data)
    && request.resource.data.by == personId() && request.resource.data.status == 'active' && request.resource.data.version == 1 && audited('expense',id);
   allow update: if isMember() && accountsOpen() && (isAdmin() || resource.data.by == personId())
    && isValidExpense(request.resource.data) && financeUpdate() && audited('expense',id);
   allow delete: if false;
  }
  function settlementOpen() { return request.time >= timestamp.date(2026,11,22) + duration.value(3,'h'); }
  function paymentParty(d) { return d.from == personId() || d.to == personId() || isAdmin(); }
  function isValidPayment(d) {
   let date=d.paidOn.split('-');
   return only(d,['from','to','amountCents','kind','settlementId','paidOn','note','by','at','createdAt','status','version','updatedAt','updatedBy'])
    && d.from in ids() && d.to in ids() && d.from != d.to && d.by in ids()
    && d.amountCents is int && d.amountCents > 0 && d.amountCents <= 100000000
    && d.kind in ['payment','settlement'] && (d.kind == 'payment' || settlementOpen())
    && optionalText(d.settlementId,3)
    && d.paidOn is string && d.paidOn.size() == 10 && d.paidOn.matches('202[0-9]-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])')
    && timestamp.date(int(date[0]),int(date[1]),int(date[2])) + duration.value(3,'h') <= request.time
    && optionalText(d.note,200) && text(d.at,40) && d.createdAt is timestamp
    && d.status in ['active','cancelled'] && financeMeta(d);
  }
  function paymentMode(d,id) {
   return d.kind == 'payment' ? accountsOpen() && d.settlementId == '' : matchesSettlement(d,id);
  }
  function matchesSettlement(d,id) {
   let c=get(/databases/$(database)/documents/financeClosings/main).data;
   return !accountsOpen() && id == 'final_' + d.settlementId && d.settlementId.matches('t([0-9]|1[0-2])')
    && c.transfers.from[int(d.settlementId.replace('t',''))] == d.from
    && c.transfers.to[int(d.settlementId.replace('t',''))] == d.to
    && c.transfers.amountCents[int(d.settlementId.replace('t',''))] == d.amountCents;
  }
  match /payments/{id} {
   allow read: if isMember();
   allow create: if isMember() && isValidPayment(request.resource.data) && paymentMode(request.resource.data,id) && paymentParty(request.resource.data)
    && fresh(request.resource.data) && request.resource.data.by == personId()
    && request.resource.data.status == 'active' && request.resource.data.version == 1 && audited('payment',id);
   allow update: if isMember() && paymentParty(resource.data) && paymentParty(request.resource.data)
    && (isAdmin() || (request.resource.data.from == resource.data.from && request.resource.data.to == resource.data.to))
    && request.resource.data.kind == resource.data.kind && request.resource.data.settlementId == resource.data.settlementId
    && isValidPayment(request.resource.data) && paymentMode(request.resource.data,id) && financeUpdate() && audited('payment',id);
   allow delete: if false;
  }
  function financeRecordPath(type,id) {
   let collection=type == 'expense' ? 'expenses' : type == 'payment' ? 'payments' : type == 'closing' ? 'financeClosings' : 'settings';
   return /databases/$(database)/documents/$(collection)/$(id);
  }
  function isValidFinanceEvent(d,eventId) {
   let p=financeRecordPath(d.type,d.recordId);
   let before=exists(p) ? get(p).data : {};
   let after=getAfter(p).data;
   return only(d,['type','recordId','version','action','by','before','after','createdAt'])
    && d.type in ['expense','payment','budget','closing'] && text(d.recordId,80) && d.recordId.matches('[a-zA-Z0-9_-]+')
    && eventId == d.type + '_' + d.recordId + '_' + string(d.version)
    && d.by == personId() && d.version is int && d.version > 0 && d.version <= 1000000
    && d.before is map && d.after is map && d.before == before && d.after == after
    && d.version == before.get('version',0) + 1 && d.version == after.version && after.updatedAt == request.time
    && after.updatedBy == personId() && d.createdAt is timestamp && d.createdAt == request.time
    && d.action == (!exists(p) ? 'create' : after.get('status','active') == 'cancelled' ? 'cancel' : 'update');
  }
  match /financeHistory/{id} {
   allow read: if isMember();
   allow create: if isMember() && isValidFinanceEvent(request.resource.data,id);
   allow update, delete: if false;
  }
  function validTransferAt(t,i,n) {
   return n <= i || (t.amountCents[i] is int && t.amountCents[i] > 0 && t.amountCents[i] <= 100000000 && t.from[i] != t.to[i]);
  }
  function validClosing(d) {
   let t=d.transfers;
   let n=t.from.size();
   let official=ids();
   return only(d,['budget','expenseTotalCents','transfers','version','updatedAt','updatedBy','closedAt','closedBy'])
    && d.budget is number && d.budget >= 0 && d.budget <= 1000000
    && d.expenseTotalCents is int && d.expenseTotalCents >= 0 && d.expenseTotalCents <= 1400000000
    && t is map && only(t,['from','to','amountCents']) && t.from is list && t.to is list && t.amountCents is list
    && n <= 13 && t.to.size() == n && t.amountCents.size() == n && t.from.hasOnly(official) && t.to.hasOnly(official)
    && validTransferAt(t,0,n) && validTransferAt(t,1,n) && validTransferAt(t,2,n) && validTransferAt(t,3,n)
    && validTransferAt(t,4,n) && validTransferAt(t,5,n) && validTransferAt(t,6,n) && validTransferAt(t,7,n)
    && validTransferAt(t,8,n) && validTransferAt(t,9,n) && validTransferAt(t,10,n) && validTransferAt(t,11,n) && validTransferAt(t,12,n)
    && d.closedAt == request.time && d.closedBy == personId() && d.version == 1 && financeMeta(d);
  }
  match /financeClosings/{id} {
   allow read: if isMember();
   allow create: if id == 'main' && isAdmin() && accountsOpen() && settlementOpen() && validClosing(request.resource.data)
    && getAfter(/databases/$(database)/documents/financeControl/main).data.closed == true && audited('closing',id);
   allow update, delete: if false;
  }
  match /financeControl/{id} {
   allow read: if isMember();
   allow create, delete: if false;
   allow update: if id == 'main' && isMember() && only(request.resource.data,['revision','closed','lastEvent'])
    && request.resource.data.revision is int && request.resource.data.revision == resource.data.revision + 1
    && text(request.resource.data.lastEvent,120) && request.resource.data.closed is bool
    && getAfter(/databases/$(database)/documents/financeHistory/$(request.resource.data.lastEvent)).data.by == personId()
    && getAfter(/databases/$(database)/documents/financeHistory/$(request.resource.data.lastEvent)).data.createdAt == request.time
    && (request.resource.data.closed == resource.data.closed || (resource.data.closed == false && request.resource.data.closed == true && isAdmin() && settlementOpen()
     && getAfter(/databases/$(database)/documents/financeClosings/main).data.closedAt == request.time));
  }
  function isValidCase(d) {
   return d.keys().hasAll(['who','by','what','status','at','createdAt']) && d.keys().hasOnly(['who','by','what','status','at','createdAt','hasPhoto']) && d.get('hasPhoto',false) is bool && d.who in ids() && d.by in ids()
    && d.who != d.by && text(d.what,500) && d.status in ['pend','ok'] && text(d.at,40) && d.createdAt is timestamp;
  }
  match /cases/{id} {
   allow read: if isMember() && (resource.data.status == 'ok' || isAdmin());
   allow create: if isMember() && isValidCase(request.resource.data) && fresh(request.resource.data)
    && request.resource.data.by == personId() && request.resource.data.status == 'pend'
    && (!request.resource.data.get('hasPhoto',false) || validPhoto(getAfter(/databases/$(database)/documents/casePhotos/$(id)).data));
   allow update: if isAdmin() && isValidCase(request.resource.data) && sameCreation()
    && resource.data.status == 'pend' && request.resource.data.status == 'ok'
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
   allow delete: if isAdmin();
  }
  // Foto JPEG reduzida, em documento separado (até 180 KB de texto).
  // Denúncias e fotos pendentes só são lidas por ADM; após condenação, membros.
  function validPhoto(d) {
   return only(d,['dataUrl']) && d.dataUrl is string && d.dataUrl.size() <= 180000
    && d.dataUrl.matches('data:image/jpeg;base64,[A-Za-z0-9+/]+={0,2}');
  }
  match /casePhotos/{id} {
   allow get: if isMember() && (get(/databases/$(database)/documents/cases/$(id)).data.status == 'ok' || isAdmin());
   allow list, update: if false;
   allow create: if isMember() && validPhoto(request.resource.data)
    && !exists(/databases/$(database)/documents/cases/$(id))
    && getAfter(/databases/$(database)/documents/cases/$(id)).data.by == personId()
    && getAfter(/databases/$(database)/documents/cases/$(id)).data.status == 'pend'
    && getAfter(/databases/$(database)/documents/cases/$(id)).data.hasPhoto == true;
   allow delete: if isAdmin();
  }
  function validReaction(value) { return value in ['😂','😱','🤦','👏','❤️']; }
  function validReactionFor(votes,id) { return !(id in votes) || validReaction(votes[id]); }
  function isValidCaseReactions(d) {
   return only(d,['votes']) && d.votes is map && d.votes.keys().hasOnly(ids())
    && validReactionFor(d.votes,'bruno') && validReactionFor(d.votes,'ob')
    && validReactionFor(d.votes,'luan') && validReactionFor(d.votes,'igor')
    && validReactionFor(d.votes,'pig') && validReactionFor(d.votes,'pelado')
    && validReactionFor(d.votes,'kirk') && validReactionFor(d.votes,'gherardi')
    && validReactionFor(d.votes,'nanu') && validReactionFor(d.votes,'sadano')
    && validReactionFor(d.votes,'ibrahim') && validReactionFor(d.votes,'cadu')
    && validReactionFor(d.votes,'diogo') && validReactionFor(d.votes,'felipe');
  }
  function publishedCase(id) { return get(/databases/$(database)/documents/cases/$(id)).data.status == 'ok'; }
  match /caseReactions/{id} {
   allow get: if isMember() && publishedCase(id);
   allow list,delete: if false;
   allow create: if isMember() && publishedCase(id) && isValidCaseReactions(request.resource.data)
    && request.resource.data.votes.keys().hasOnly([personId()])
    && validReaction(request.resource.data.votes.get(personId(),''));
   allow update: if isMember() && publishedCase(id) && isValidCaseReactions(request.resource.data)
    && request.resource.data.votes.diff(resource.data.votes).affectedKeys().hasOnly([personId()]);
  }
  function isValidTask(d) {
   return only(d,['who','d','why','status','at','createdAt']) && d.who in ids()
    && d.d is int && d.d >= 1 && d.d <= 20 && text(d.why,200)
    && d.status in ['pend','ok','no'] && text(d.at,40) && d.createdAt is timestamp;
  }
  match /tasks/{id} {
   allow read: if isMember();
   allow create: if isMember() && isValidTask(request.resource.data) && fresh(request.resource.data)
    && request.resource.data.who == personId() && request.resource.data.status == 'pend';
   allow update: if isAdmin() && isValidTask(request.resource.data) && sameCreation()
    && resource.data.status == 'pend' && request.resource.data.status in ['ok','no']
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
   allow delete: if isAdmin();
  }
  function isValidChat(d) { return only(d,['text','createdAt']) && text(d.text,280) && d.createdAt is timestamp; }
  match /chat/{id} {
   allow read: if isMember();
   allow create: if isMember() && isValidChat(request.resource.data) && fresh(request.resource.data);
   allow update: if false;
   allow delete: if isAdmin();
  }
  function isToday(day) { return day == string(int((request.time.toMillis() - 10800000) / 86400000)); }
  function resultsReleased(day) {
   return day in ['20776','20777','20778','20779'] && request.time.toMillis() >= int(day) * 86400000 + 54000000;
  }
  function votingOpen() {
   let local=request.time.toMillis()-10800000;
   return local >= 1795046400000 && local < 1795392000000 && local % 86400000 < 43200000;
  }
  // A subtração só aceita números; delta enumerado garante um único incremento.
  // A partir de zero, com 14 votantes e sem voto próprio, cada dígito tem máximo13.
  function isValidTallyDelta(delta,self,increments) { return self ? delta == 0 : delta in increments; }
  function isValidVoteDay(d,old,day) {
   let me=personId();
   let before=old.counts;
   let after=d.counts;
   let official=ids();
   let increments=[1,16,256,4096,65536,1048576,16777216,268435456];
   return isToday(day) && votingOpen() && only(d,['counts','voters']) && d.voters is int && d.voters == old.voters + 1 && d.voters <= 14
    && d.counts is map && after.keys().hasAll(official) && after.keys().hasOnly(official)
    && isValidTallyDelta(after['bruno']-before.get('bruno',0),'bruno'==me,increments)
    && isValidTallyDelta(after['ob']-before.get('ob',0),'ob'==me,increments)
    && isValidTallyDelta(after['luan']-before.get('luan',0),'luan'==me,increments)
    && isValidTallyDelta(after['igor']-before.get('igor',0),'igor'==me,increments)
    && isValidTallyDelta(after['pig']-before.get('pig',0),'pig'==me,increments)
    && isValidTallyDelta(after['pelado']-before.get('pelado',0),'pelado'==me,increments)
    && isValidTallyDelta(after['kirk']-before.get('kirk',0),'kirk'==me,increments)
    && isValidTallyDelta(after['gherardi']-before.get('gherardi',0),'gherardi'==me,increments)
    && isValidTallyDelta(after['nanu']-before.get('nanu',0),'nanu'==me,increments)
    && isValidTallyDelta(after['sadano']-before.get('sadano',0),'sadano'==me,increments)
    && isValidTallyDelta(after['ibrahim']-before.get('ibrahim',0),'ibrahim'==me,increments)
    && isValidTallyDelta(after['cadu']-before.get('cadu',0),'cadu'==me,increments)
    && isValidTallyDelta(after['diogo']-before.get('diogo',0),'diogo'==me,increments)
    && isValidTallyDelta(after['felipe']-before.get('felipe',0),'felipe'==me,increments);
  }
  function emptyDay() { return {'counts':{},'voters':0}; }
  function previousVoters(day) {
   let path=/databases/$(database)/documents/querido/$(day);
   return exists(path) ? get(path).data.voters : 0;
  }
  function newVoter(day) {
   let path=/databases/$(database)/documents/querido/$(day)/voters/$(request.auth.uid);
   return !exists(path) && getAfter(path).data == {'voted':true}
    && getAfter(/databases/$(database)/documents/participation/$(day)/people/$(personId())).data == {'voted':true};
  }
  match /querido/{day} {
   allow get: if isMember() && resultsReleased(day);
   allow list, delete: if false;
   allow create, update: if isMember() && newVoter(day)
    && isValidVoteDay(request.resource.data,request.method == 'create' ? emptyDay() : resource.data,day);
   match /voters/{uid} {
    allow get: if isMember() && isOwner(uid);
    allow list, update, delete: if false;
    // O avanço do pai, obrigatório aqui, valida o membro, o dia e todos os contadores.
    allow create: if isOwner(uid) && votingOpen() && isToday(day) && request.resource.data == {'voted':true}
     && getAfter(/databases/$(database)/documents/querido/$(day)).data.voters == previousVoters(day) + 1;
   }
  }
  // Participação registra apenas a entrega, nunca os emojis escolhidos.
  match /participation/{day}/people/{id} {
   allow read: if isMember() && resultsReleased(day);
   allow create: if isMember() && id == personId() && isToday(day) && votingOpen()
    && request.resource.data == {'voted':true}
    && !exists(/databases/$(database)/documents/querido/$(day)/voters/$(request.auth.uid))
    && getAfter(/databases/$(database)/documents/querido/$(day)/voters/$(request.auth.uid)).data == {'voted':true}
    && getAfter(/databases/$(database)/documents/querido/$(day)).data.voters == previousVoters(day) + 1;
   allow update, delete: if false;
  }
  match /{document=**} { allow read, write: if false; }
 }
}
